<?xml version="1.0"?>
<robot name="dif" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Placeholder dimensions in metres, NOT calibrated hardware dimensions. -->
  <xacro:arg name="simulation" default="false"/>
  <xacro:property name="wheel_radius" value="0.075"/>
  <xacro:property name="wheel_width" value="0.035"/>
  <xacro:property name="wheel_separation" value="0.32"/>
  <xacro:property name="body_length" value="0.40"/>
  <xacro:property name="body_width" value="0.26"/>
  <xacro:property name="body_height" value="0.10"/>
  <xacro:property name="body_z" value="0.13"/>
  <xacro:include filename="inertial.xacro"/>

  <material name="blue"><color rgba="0.12 0.35 0.70 1"/></material>
  <material name="black"><color rgba="0.08 0.08 0.08 1"/></material>
  <material name="silver"><color rgba="0.65 0.65 0.65 1"/></material>

  <link name="base_footprint"/>
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/><child link="base_link"/>
    <origin xyz="0 0 ${body_z}"/>
  </joint>
  <link name="base_link">
    <visual><geometry><box size="${body_length} ${body_width} ${body_height}"/></geometry><material name="blue"/></visual>
    <collision><geometry><box size="${body_length} ${body_width} ${body_height}"/></geometry></collision>
    <xacro:box_inertial mass="5.0" x="${body_length}" y="${body_width}" z="${body_height}"/>
  </link>

  <xacro:macro name="wheel" params="side sign">
    <joint name="${side}_wheel_joint" type="continuous">
      <parent link="base_link"/><child link="${side}_wheel_link"/>
      <origin xyz="0 ${sign * wheel_separation / 2} ${wheel_radius - body_z}"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.01" friction="0.0"/>
    </joint>
    <link name="${side}_wheel_link">
      <visual><origin rpy="${pi/2} 0 0"/><geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry><material name="black"/></visual>
      <collision><origin rpy="${pi/2} 0 0"/><geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry></collision>
      <inertial>
        <mass value="0.3"/>
        <inertia ixx="${0.3*(3*wheel_radius**2+wheel_width**2)/12}" ixy="0" ixz="0" iyy="${0.3*wheel_radius**2/2}" iyz="0" izz="${0.3*(3*wheel_radius**2+wheel_width**2)/12}"/>
      </inertial>
    </link>
    <gazebo reference="${side}_wheel_link"><mu1>1.0</mu1><mu2>1.0</mu2><material>Gazebo/Black</material></gazebo>
  </xacro:macro>
  <xacro:wheel side="left" sign="1"/>
  <xacro:wheel side="right" sign="-1"/>

  <!-- Low-friction spherical supports approximate passive casters. -->
  <xacro:macro name="caster" params="name x">
    <joint name="${name}_caster_joint" type="fixed">
      <parent link="base_link"/><child link="${name}_caster_link"/>
      <origin xyz="${x} 0 ${0.025-body_z}"/>
    </joint>
    <link name="${name}_caster_link">
      <visual><geometry><sphere radius="0.025"/></geometry><material name="silver"/></visual>
      <collision><geometry><sphere radius="0.025"/></geometry></collision>
      <inertial><mass value="0.05"/><inertia ixx="0.0000125" ixy="0" ixz="0" iyy="0.0000125" iyz="0" izz="0.0000125"/></inertial>
    </link>
    <gazebo reference="${name}_caster_link"><mu1>0.01</mu1><mu2>0.01</mu2></gazebo>
  </xacro:macro>
  <xacro:caster name="front" x="0.15"/>
  <xacro:caster name="rear" x="-0.15"/>

  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/><child link="laser_frame"/>
    <origin xyz="0.08 0 0.10"/>
  </joint>
  <link name="laser_frame">
    <visual><geometry><cylinder radius="0.035" length="0.04"/></geometry><material name="black"/></visual>
    <collision><geometry><cylinder radius="0.035" length="0.04"/></geometry></collision>
    <inertial><mass value="0.1"/><inertia ixx="0.000044" ixy="0" ixz="0" iyy="0.000044" iyz="0" izz="0.000061"/></inertial>
  </link>
  <xacro:if value="$(arg simulation)">
    <xacro:include filename="gazebo.xacro"/>
  </xacro:if>
</robot>
