{
  "name": "ROS DIF · Humble + Fortress",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "USERNAME": "ros"
    }
  },
  "remoteUser": "ros",
  "updateRemoteUserUID": true,
  "workspaceFolder": "/workspaces/ros-dif",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/ros-dif,type=bind",
  "runArgs": [
    "--network=host",
    "--ipc=host",
    "--device=/dev/input:/dev/input",
    "--group-add=104"
  ],
  "mounts": [
    "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind",
    "source=ros-dif-commandhistory,target=/commandhistory,type=volume"
  ],
  "containerEnv": {
    "DISPLAY": "${localEnv:DISPLAY}",
    "QT_X11_NO_MITSHM": "1",
    "LIBGL_ALWAYS_SOFTWARE": "1",
    "ROS_DIF_WORKSPACE": "/workspaces/ros-dif"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools",
        "redhat.vscode-yaml",
        "dotjoshjohnson.xml"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  "postCreateCommand": "bash .devcontainer/setup-dev-env.sh"
}
